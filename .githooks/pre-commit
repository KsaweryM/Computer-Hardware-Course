#!/bin/sh
# Before every commit: if a presentation (Lecture_*/main.tex) is part of the commit,
# rebuild the presentations that changed and add the new PDFs to the same commit.
#
# Turn it on once in a fresh clone:   git config core.hooksPath .githooks
# Skip it for one commit:             git commit --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

if ! git diff --cached --name-only | grep -q '^Lecture_[^/]*/main\.tex$'; then
  exit 0
fi

echo "pre-commit: building the presentations that changed..."
mkdir -p build
if ! make --no-print-directory all > build/pre-commit.log 2>&1; then
  tail -n 20 build/pre-commit.log
  echo "pre-commit: the build failed, the commit was stopped (full log: build/pre-commit.log)."
  exit 1
fi
git add builded_presentation
echo "pre-commit: PDFs are up to date and added to the commit."
